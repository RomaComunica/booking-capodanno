APP_NAME=Booking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capodanno
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.siteground.net
MAIL_PORT=465
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=booking@tuodominio.it
MAIL_FROM_NAME="Booking"

# PayPal Express Checkout (NVP API)
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_API_USERNAME=your_sandbox_username
PAYPAL_SANDBOX_API_PASSWORD=your_sandbox_password
PAYPAL_SANDBOX_API_SIGNATURE=your_sandbox_signature
PAYPAL_LIVE_API_USERNAME=your_live_username
PAYPAL_LIVE_API_PASSWORD=your_live_password
PAYPAL_LIVE_API_SIGNATURE=your_live_signature

# Nexi XPay
NEXI_MODE=test
NEXI_TEST_ALIAS=your_test_alias
NEXI_TEST_SECRET_KEY=your_test_secret_key
NEXI_PRODUCTION_ALIAS=your_production_alias
NEXI_PRODUCTION_SECRET_KEY=your_production_secret_key
